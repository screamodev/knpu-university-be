# ──────────────────────────────────────────────────────────────────────────────
# Directus security keys. Generate fresh per environment — DO NOT reuse the
# pizzeria stack's values.
#   KEY:    node -e "console.log(require('crypto').randomUUID())"
#   SECRET: openssl rand -base64 48 | tr -d '/+=' | head -c 48
# ──────────────────────────────────────────────────────────────────────────────
KEY=
SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Initial admin user. Created on first boot when the database is empty.
# Change the password immediately via the admin UI after first login.
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# Database — points at the SHARED Postgres container running alongside the
# pizzeria stack. DB_HOST is the Docker DNS name of that container on `dbnet`.
# Generate the role + password with the SQL block in plan Phase 2 before
# filling these in.
# ──────────────────────────────────────────────────────────────────────────────
DB_CLIENT=pg
DB_HOST=
DB_PORT=5432
DB_DATABASE=knpu_university
DB_USER=directus_knpu
DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# Public-facing URL of this Directus instance. Used by the admin UI, in
# generated asset URLs, and inside the bootstrap scripts.
# ──────────────────────────────────────────────────────────────────────────────
PUBLIC_URL=https://hnpu-admin.dev42hub.uk

# ──────────────────────────────────────────────────────────────────────────────
# CORS — only the production frontend should hit this API from a browser.
# No trailing slash. For multiple origins, comma-separate.
# ──────────────────────────────────────────────────────────────────────────────
CORS_ENABLED=true
CORS_ORIGIN=https://hnpu.dev42hub.uk

# ──────────────────────────────────────────────────────────────────────────────
# Realtime & auth tokens.
# ──────────────────────────────────────────────────────────────────────────────
WEBSOCKETS_ENABLED=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ──────────────────────────────────────────────────────────────────────────────
# Demo content seeding. Keep `false` here — run snapshots/seed-content.sh once,
# manually, after schema apply (see plan Phase 8). Setting this to `true` runs
# seed on every container start, which is not what you want.
# ──────────────────────────────────────────────────────────────────────────────
SEED_CONTENT=false
