# Local environment (never commit secrets).
.env
.env.*
!.env.example
!.env.prod.example

# OS / editor cruft.
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Runtime artefacts from docker volumes if someone bind-mounts them locally.
uploads/
# Extensions ship with the repo (prod bind-mounts ./extensions), but their builds and
# dependencies do not need to be rebuilt on the server — only dist/ + package.json.
extensions/*/node_modules/
extensions/*/package-lock.json
database/migrations/*
!database/migrations/.gitkeep

# Logs.
*.log
logs/

# Node (only relevant if custom extensions are added later).
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
