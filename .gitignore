# Local environment (never commit secrets).
.env
.env.*
!.env.example
!.env.prod.example

# OS / editor cruft.
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Runtime artefacts from docker volumes if someone bind-mounts them locally.
uploads/
# Extensions ship with the repo (prod bind-mounts ./extensions), but their builds and
# dependencies do not need to be rebuilt on the server — only dist/ + package.json.
extensions/*/node_modules/
extensions/*/package-lock.json
database/migrations/*
!database/migrations/.gitkeep

# Migration scratch: cached copies of legacy pages, re-fetched on demand.
migration/*/.cache/
__pycache__/

# Logs.
*.log
logs/

# Node (only relevant if custom extensions are added later).
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Матеріали з Google Drive для ДВВ магістратури 2026/2028: ~300 МБ, качаються скриптом
# за картою migration/dvv-2026/files.map.json.
migration/dvv-2026/files/

# Публічні файли з Drive для правок 08.09 качає migration/fixes-2026-09-08/push_assets.py
# за картою files.map.json; у git лежать лише ті, у яких drive_id порожній.
migration/fixes-2026-09-08/files/*.pdf

# Документи ради 09.09 качає migration/fixes-2026-09-09/push_assets.py за files.map.json;
# у git лежать лише зменшені фотографії (drive_id порожній).
migration/fixes-2026-09-09/files/bohdan-*.pdf
migration/fixes-2026-09-09/files/leonidova-*.pdf
migration/fixes-2026-09-09/files/podenko-*.pdf
migration/fixes-2026-09-09/files/spped-*.pdf

# Документи зі старого сайту для правок 16.09 качає migration/fixes-2026-09-16/push_assets.py за
# адресою `url` у files.map.json; фото й файли з пошти лежать у git.
migration/fixes-2026-09-16/files/sci-*.pdf
migration/fixes-2026-09-16/files/sci-*.doc
migration/fixes-2026-09-16/files/sci-*.docx
migration/fixes-2026-09-16/files/sci-*.xls
migration/fixes-2026-09-16/files/sci-*.xlsx
migration/fixes-2026-09-16/files/sci-*.ppt
migration/fixes-2026-09-16/files/sci-*.pptx
migration/fixes-2026-09-16/files/sci-*.rtf

# Службові файли агента (oh-my-claudecode), не для репозиторію.
.omc/

# Контекстний файл Claude Code: містить операційні деталі (шляхи на проді,
# процедуру деплою, службову пошту), а репозиторій публічний. Лишається локальним.
CLAUDE.md
