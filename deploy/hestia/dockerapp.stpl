# hnpu.edu.ua — HTTPS in front of the Nuxt container (docker-compose.host.yml publishes
# it on 127.0.0.1:3000).
server {
    listen      %ip%:%proxy_ssl_port% ssl;
    http2       on;
    server_name %domain_idn% %alias_idn%;

    ssl_certificate     %ssl_pem%;
    ssl_certificate_key %ssl_key%;

    # Renewals reuse the http-01 challenge, and Hestia may probe over HTTPS.
    location ^~ /.well-known/acme-challenge/ {
        root         %home%/%user%/web/%domain%/public_html;
        default_type text/plain;
        try_files    $uri =404;
    }

    client_max_body_size 512m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        # Nuxt streams the SSR response; buffering it adds latency for no gain.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    include %home%/%user%/conf/web/%domain%/nginx.conf_*;
}
